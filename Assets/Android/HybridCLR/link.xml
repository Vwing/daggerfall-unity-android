<!--
    Mod assemblies are loaded at runtime by HybridCLR, so the linker never sees what they call.
    Keep the APIs mods commonly use instead of stripping whatever the base game doesn't touch.
-->
<linker>
    <assembly fullname="Assembly-CSharp" preserve="all" />
    <assembly fullname="Assembly-CSharp-firstpass" preserve="all" ignoreIfMissing="1" />
    <assembly fullname="mscorlib" preserve="all" />
    <assembly fullname="System" preserve="all" />
    <assembly fullname="System.Core" preserve="all" />
    <assembly fullname="System.Xml" preserve="all" />
    <assembly fullname="UnityEngine.CoreModule" preserve="all" />
    <assembly fullname="UnityEngine.AnimationModule" preserve="all" ignoreIfMissing="1" />
    <assembly fullname="UnityEngine.AssetBundleModule" preserve="all" ignoreIfMissing="1" />
    <assembly fullname="UnityEngine.AudioModule" preserve="all" ignoreIfMissing="1" />
    <assembly fullname="UnityEngine.ImageConversionModule" preserve="all" ignoreIfMissing="1" />
    <assembly fullname="UnityEngine.IMGUIModule" preserve="all" ignoreIfMissing="1" />
    <assembly fullname="UnityEngine.InputLegacyModule" preserve="all" ignoreIfMissing="1" />
    <assembly fullname="UnityEngine.JSONSerializeModule" preserve="all" ignoreIfMissing="1" />
    <assembly fullname="UnityEngine.ParticleSystemModule" preserve="all" ignoreIfMissing="1" />
    <assembly fullname="UnityEngine.PhysicsModule" preserve="all" ignoreIfMissing="1" />
    <assembly fullname="UnityEngine.TerrainModule" preserve="all" ignoreIfMissing="1" />
    <assembly fullname="UnityEngine.TextRenderingModule" preserve="all" ignoreIfMissing="1" />
    <assembly fullname="UnityEngine.UI" preserve="all" ignoreIfMissing="1" />
    <assembly fullname="UnityEngine.UIModule" preserve="all" ignoreIfMissing="1" />
    <assembly fullname="UnityEngine.UnityWebRequestModule" preserve="all" ignoreIfMissing="1" />
    <assembly fullname="FullSerializer - Unity" preserve="all" />
    <assembly fullname="Unity.Localization" preserve="all" />
    <assembly fullname="Unity.Postprocessing.Runtime" preserve="all" />
    <assembly fullname="Unity.ResourceManager" preserve="all" />
    <assembly fullname="Newtonsoft.Json" preserve="all" />

    <!-- ModSourceCompiler and ModAssemblyPatcher: Roslyn compiles mods' C# source on IL2CPP builds, dnlib patches mod assemblies -->
    <assembly fullname="Microsoft.CodeAnalysis" preserve="all" ignoreIfMissing="1" />
    <assembly fullname="Microsoft.CodeAnalysis.CSharp" preserve="all" ignoreIfMissing="1" />
    <assembly fullname="System.Collections.Immutable" preserve="all" ignoreIfMissing="1" />
    <assembly fullname="System.Reflection.Metadata" preserve="all" ignoreIfMissing="1" />
    <assembly fullname="dnlib" preserve="all" ignoreIfMissing="1" />
</linker>
